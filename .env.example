# Modèle des variables d'environnement nécessaires aux tests.
# Copier ce fichier en .env puis adapter les valeurs. Le fichier .env n'est JAMAIS commité
# (il est dans .gitignore) car il peut contenir des secrets.
# Pour un autre environnement, créer .env.staging, .env.preprod..., puis lancer : TEST_ENV=staging pytest
# En CI, ces valeurs viennent des variables et secrets GitHub (voir .github/workflows/playwright.yml).

TEST_ENV=dev
BASE_URL=https://www.saucedemo.com
API_URL=https://jsonplaceholder.typicode.com
STANDARD_USER=standard_user
LOCKED_USER=locked_out_user
USER_PASSWORD=secret_sauce
